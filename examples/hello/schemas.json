{
  "findProjects": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "number"
        },
        "query": {
          "type": "string",
          "description": "Words to match in a project name."
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "projects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "projects"
      ],
      "additionalProperties": false
    }
  }
}
